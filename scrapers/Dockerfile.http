# Scraper que NO necesita navegador (Falabella: SSR con Next.js).
# Imagen mínima: sin Chromium no hay 1.5 GB que arrastrar.
FROM node:22-alpine

WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

COPY package.json tsconfig.json ./
RUN npm install --no-audit --no-fund

COPY src ./src
RUN npx tsc

CMD ["node", "dist/falabella.js"]
